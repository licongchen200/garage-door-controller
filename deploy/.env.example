# Required. Use a random, private value of at least 32 characters.
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
# Must exactly match the iOS PRODUCT_BUNDLE_IDENTIFIER.
APPLE_BUNDLE_ID=org.licongchen.home

# MQTT uses the broker's directly exposed mutual-TLS listener. Under
# docker-compose.yml, these values are forced to the compose service name and
# the mounted certificate paths below.
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_CA_FILE=/run/mqtt-certs/ca.crt
MQTT_CERT_FILE=/run/mqtt-certs/client.crt
MQTT_KEY_FILE=/run/mqtt-certs/client.key
MQTT_ACK_TIMEOUT_SECONDS=3

# Host directory docker-compose.yml mounts into the broker and API containers.
# setup.sh creates the CA, broker identity, and garage-api client identity here.
MQTT_DIR=~/mqtt

# Five relay attempts per user per 60-second window.
RATE_LIMIT_MAX_CALLS=5
RATE_LIMIT_WINDOW_SECONDS=60

# App JWT lifetime is exactly 30 days. Change only deliberately.
JWT_TTL_DAYS=30

# PostgreSQL is dedicated to this deployment and uses its own named Docker volume.
# URL-encode any reserved characters in POSTGRES_PASSWORD before putting it in DATABASE_URL.
POSTGRES_DB=garage
POSTGRES_USER=garage
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://garage:replace-with-a-long-random-database-password@postgres:5432/garage
