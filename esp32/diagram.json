{
  "version": 1,
  "author": "garage-door-controller",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-c3-devkitm-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led",
      "top": -90,
      "left": 280,
      "attrs": { "color": "blue", "label": "door state" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "closed-reed",
      "top": 120,
      "left": 300,
      "attrs": { "color": "green", "label": "closed reed", "key": "C", "bounce": "0" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "open-reed",
      "top": 200,
      "left": 300,
      "attrs": { "color": "red", "label": "open reed", "key": "O", "bounce": "0" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay",
      "top": 120,
      "left": 500,
      "attrs": { "transistor": "pnp" }
    }
  ],
  "connections": [
    [ "esp:3V3.1", "led:A", "red", [] ],
    [ "esp:8", "led:C", "green", [] ],
    [ "esp:5", "closed-reed:1.l", "green", [] ],
    [ "closed-reed:2.l", "esp:GND.1", "black", [] ],
    [ "esp:6", "open-reed:1.l", "green", [] ],
    [ "open-reed:2.l", "esp:GND.1", "black", [] ],
    [ "esp:5V", "relay:VCC", "red", [] ],
    [ "esp:GND.1", "relay:GND", "black", [] ],
    [ "esp:4", "relay:IN", "green", [] ]
  ]
}
