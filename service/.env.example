# Required. Use a random, private value of at least 32 characters.
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
# Must exactly match the iOS PRODUCT_BUNDLE_IDENTIFIER.
APPLE_BUNDLE_ID=com.example.garagedoor

# MQTT is local to the home network. Defaults work for a local Mosquitto broker.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ACK_TIMEOUT_SECONDS=3

# Five relay attempts per user per 60-second window.
RATE_LIMIT_MAX_CALLS=5
RATE_LIMIT_WINDOW_SECONDS=60

# App JWT lifetime is exactly 30 days. Change only deliberately.
JWT_TTL_DAYS=30
